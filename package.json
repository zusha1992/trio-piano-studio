{
  "name": "trio-piano-studio-website",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply trio-piano-studio --local",
    "db:migrate:remote": "wrangler d1 migrations apply trio-piano-studio --remote",
    "db:seed:gen": "node scripts/generate-seed.ts",
    "db:seed:local": "wrangler d1 execute trio-piano-studio --local --file db/seed.sql",
    "db:seed:remote": "wrangler d1 execute trio-piano-studio --remote --file db/seed.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "next": "^14.2.35",
    "next-intl": "^4.13.0",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
